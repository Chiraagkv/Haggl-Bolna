# Copy to .env and fill in. Never commit .env.

# --- Bolna ---
BOLNA_API_KEY=bn-e15f01de45c24443a58df1ecdc69053c
BOLNA_BASE_URL=https://api.bolna.ai

# --- Database ---
# Dev default is a local SQLite file so nothing needs installing.
# For Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://dalaal:dalaal@localhost:5432/dalaal
DATABASE_URL=sqlite:///./dalaal.db

# --- Public URL Bolna can reach (your tunnel). Set after running scripts/tunnel.sh ---
PUBLIC_BASE_URL=https://enlargement-speaks-southwest-judges.trycloudflare.com 

# --- Webhooks ---
# Bolna's documented source IPs. Set ENFORCE_WEBHOOK_IPS=true once you are behind a
# proxy that preserves the real client IP; leave false while testing through a tunnel.
WEBHOOK_ALLOWED_IPS=13.203.39.153,13.126.9.249,13.202.133.53
ENFORCE_WEBHOOK_IPS=false

# --- Provider: "bolna" for real calls, "fake" to simulate suppliers (no key, no cost) ---
PROVIDER=bolna

# --- Agents (printed by scripts/create_agents.py) ---
SUPPLIER_AGENT_ID=
SUPPLIER_R2_AGENT_ID=
APPROVAL_AGENT_ID=
CONFIRM_AGENT_ID=
CALLBACK_AGENT_ID=
INTAKE_AGENT_ID=

# --- Safety ---
# Secret the submit_quote tool sends in the X-Dalaal-Token header. Set it before any real test.
TOOL_SECRET=
# Only these numbers may be dialed by our scripts (comma-separated, E.164, teammates only).
VERIFIED_NUMBERS=

# --- Limits (see ticket #1 and #18). Read the real values from Bolna Account Info. ---
CONCURRENCY_LIMIT=2
# Per wave: round 1 calls suppliers in groups of CONCURRENCY_LIMIT (pairs on a trial) that sell the same items
ROUND1_DEADLINE_SECONDS=150
# Free tier is $5 once (~Rs 460). One full order is ~9 one-minute calls (~Rs 55).
COST_CEILING_PER_ORDER_INR=75
DAILY_CAP_INR=400
KILL_SWITCH=false

# --- Calls and timing ---
# Calls are only placed when Bolna can take them; we queue the rest ourselves (round 1 waits for the slowest).
STAGE_TIMEOUT_SECONDS=150
POLL_STALE_AFTER_SECONDS=45
MAX_BOOKING_ATTEMPTS=2
# Background loop (watchdog + dispatcher). Leave on.
BACKGROUND_LOOP=true
LOOP_INTERVAL_SECONDS=2
# Fake provider pacing in seconds per step (PROVIDER=fake only; makes the dashboard watchable)
FAKE_DELAY_SECONDS=2
# Testing: call this number instead of the owner's saved one (still must be in VERIFIED_NUMBERS)
OWNER_PHONE_OVERRIDE=
# total_cost is US cents (measured: 6.0 for a 60 s call, wallet 500 -> 494), so 1 unit is ~Rs 0.92.
# Do NOT use 0.01: the spend caps would then see 1% of the real cost and never stop anything.
COST_UNIT_TO_INR=0.92
# Rupees per unit of the wallet balance from GET /user/me. It is US cents (500.0 = $5.00), so ~0.92.
# Orders that the wallet cannot cover are refused before any call is placed.
WALLET_UNIT_TO_INR=0.92
